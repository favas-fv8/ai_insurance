# ============================================================
# Ai-IPP Frontend environment variables (Create React App)
# Only variables prefixed with REACT_APP_ are available in the
# browser bundle at build time.
#
# Copy to `.env` for local development or set these in your
# Vercel project dashboard (Settings -> Environment Variables).
# NEVER commit real `.env` files.
# ============================================================

# Base URL of the deployed Django API (must end with /api).
# Local development:
REACT_APP_API_URL=http://localhost:8000/api
# Vercel production example:
# REACT_APP_API_URL=https://your-render-service.onrender.com/api

# Display name used by the frontend.
REACT_APP_NAME=Ai-IPP