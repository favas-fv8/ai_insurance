# ============================================================
# Ai-IPP Backend environment variables
# Copy this file to `.env` for local development, or set these
# variables in your Render service dashboard.
# NEVER commit the real `.env` file.
# ============================================================

# Django
DJANGO_SECRET_KEY=ai-ipp-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Prefer a single DATABASE_URL on Render (provided automatically by the
# Render Postgres instance). Local development can keep the DB_* variables.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS / CSRF
# Add every frontend origin you deploy (one or more Vercel domains),
# e.g. https://ai-ipp.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional production overrides (safe defaults are applied automatically)
# DJANGO_SECURE_SSL_REDIRECT=False
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOW_CREDENTIALS=True
# DJANGO_ACCESS_TOKEN_LIFETIME_MINUTES=60
# DJANGO_REFRESH_TOKEN_LIFETIME_DAYS=7

# API (used by local tooling/docs)
API_BASE_URL=http://localhost:8000/api